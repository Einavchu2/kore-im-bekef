# Copy to .env for local development (netlify dev reads it). Never commit .env.
# Speech provider: set ONE of these. Google is used when both are set.
GOOGLE_TTS_API_KEY=AIza_your_key_here
# SONEX_API_KEY=vsk_your_key_here
TTS_ADMIN_PASSWORD=choose-a-long-password
# Optional:
# GOOGLE_TTS_VOICE=he-IL-Chirp3-HD-...
# TTS_DAILY_NEW_LIMIT=300
